# Leave DATABASE_URL empty to use the embedded PostgreSQL + PostGIS database
# created in server/.pglite (no separate install).
# To use a full PostgreSQL server instead:
# DATABASE_URL=postgres://civicare:civicare@localhost:5432/civicare
DATABASE_URL=

# Change this before any shared or public deployment.
JWT_SECRET=dev-only-change-me

PORT=4000
